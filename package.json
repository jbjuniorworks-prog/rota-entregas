{
  "name": "rota-entregas",
  "private": true,
  "type": "module",
  "scripts": {
    "planilhas": "node testes/gerar-planilhas.mjs",
    "motoristas": "node ferramentas/motoristas.mjs",
    "test:unidade": "vitest run",
    "tipos": "tsc -p .",
    "test": "playwright test --grep-invert \"@nuvem|@leitor|@ui\"",
    "test:nuvem": "playwright test --grep @nuvem --workers 1",
    "dev": "vite",
    "build": "vite build",
    "ruas": "node ferramentas/ruas.mjs",
    "backup": "node ferramentas/backup.mjs",
    "restaurar": "node ferramentas/restaurar.mjs",
    "cnefe": "node ferramentas/cnefe.mjs",
    "bairros": "node ferramentas/bairros.mjs",
    "prefeitura": "node ferramentas/prefeitura.mjs",
    "rechavear": "node ferramentas/rechavear.mjs",
